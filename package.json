{
  "name": "easse",
  "version": "0.1.1",
  "description": "Easy & Resilient Server-Sent Events for Express",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "demo": "tsx demo/server.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "sse",
    "server-sent-events",
    "express",
    "real-time",
    "notifications",
    "eventsource",
    "resilient",
    "easse",
    "websocket-alternative",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "author": "Elber Nava",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.30",
    "express": "^5.2.1",
    "express4": "npm:express@^4.22.3",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@types/express": "^4.17.0 || ^5.0.0",
    "express": "^4.18.0 || ^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elbernv/easse.git"
  },
  "homepage": "https://github.com/elbernv/easse#readme",
  "bugs": {
    "url": "https://github.com/elbernv/easse/issues"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    }
  }
}
